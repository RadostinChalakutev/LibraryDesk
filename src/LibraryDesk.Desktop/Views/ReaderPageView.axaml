<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LibraryDesk.Desktop.Views.ReaderPageView">
  <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,*" ColumnSpacing="24" RowSpacing="16">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox Width="240" Watermark="Search name, number, or email" Text="{Binding SearchText, Mode=TwoWay}" />
      <CheckBox Content="Include inactive" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center" />
      <Button Content="Search" Command="{Binding RefreshCommand}" />
    </StackPanel>
    <Border Grid.Row="1" Padding="12" Background="#F4F6F9" CornerRadius="8">
      <ListBox ItemsSource="{Binding Readers}" SelectedItem="{Binding SelectedReader, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="120,*,150,90" Margin="4">
              <TextBlock Text="{Binding MembershipNumber}" />
              <TextBlock Grid.Column="1" Text="{Binding FullName}" />
              <TextBlock Grid.Column="2" Text="{Binding Email}" />
              <TextBlock Grid.Column="3" Text="{Binding IsActive}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Border Grid.Column="1" Grid.RowSpan="2" Padding="20" Background="#F4F6F9" CornerRadius="8">
      <StackPanel Spacing="10">
        <TextBlock Text="Reader details" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Membership number" />
        <TextBox Text="{Binding MembershipNumber, Mode=TwoWay}" IsEnabled="{Binding CanEditMembership}" />
        <TextBlock Text="Full name" />
        <TextBox Text="{Binding FullName, Mode=TwoWay}" />
        <TextBlock Text="Email" />
        <TextBox Text="{Binding Email, Mode=TwoWay}" />
        <TextBlock Text="Phone" />
        <TextBox Text="{Binding Phone, Mode=TwoWay}" />
        <TextBlock Text="{Binding StatusMessage}" Foreground="#526173" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Content="Save" Command="{Binding SaveCommand}" />
          <Button Content="New" Command="{Binding NewReaderCommand}" />
          <Button Content="Toggle active" Command="{Binding ToggleActiveCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
