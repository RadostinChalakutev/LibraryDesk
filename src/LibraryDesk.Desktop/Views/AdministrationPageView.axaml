<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LibraryDesk.Desktop.Views.AdministrationPageView">
  <ScrollViewer>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
      <TextBlock Text="Administration and backup" FontSize="22" FontWeight="SemiBold" />
      <Border Grid.Row="1" Padding="20" Background="#F4F6F9" CornerRadius="8">
        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
          <TextBlock Grid.ColumnSpan="4" Text="Create staff account" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Text="Display name" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="Username" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="Password" />
          <TextBlock Grid.Row="1" Grid.Column="3" Text="Role" />
          <TextBox Grid.Row="2" Text="{Binding DisplayName, Mode=TwoWay}" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Username, Mode=TwoWay}" />
          <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●" />
          <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}" MinWidth="110" />
            <Button Content="Create" Command="{Binding CreateUserCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="2" Padding="12" Background="#F4F6F9" CornerRadius="8">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Local accounts" FontSize="18" FontWeight="SemiBold" />
            <Button Content="Refresh" Command="{Binding RefreshUsersCommand}" />
            <Button Content="{Binding ToggleSelectedUserLabel}" Command="{Binding ToggleSelectedUserCommand}" />
            <Button Content="Create database backup" Command="{Binding CreateBackupCommand}" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" MinHeight="140">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,140,100" Margin="4">
                  <TextBlock Text="{Binding DisplayName}" />
                  <TextBlock Grid.Column="1" Text="{Binding Role}" />
                  <TextBlock Grid.Column="2" Text="{Binding IsActive}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#526173" TextWrapping="Wrap" />
    </Grid>
  </ScrollViewer>
</UserControl>
