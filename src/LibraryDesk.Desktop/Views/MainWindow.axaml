<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LibraryDesk.Desktop.Views.MainWindow"
        Title="LibraryDesk"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="250,*">
    <Border Background="#172033" Padding="20">
      <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Text="LibraryDesk" Foreground="White" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,6,0,28" Text="Library operations" Foreground="#B9C4D9" />
        <ListBox Grid.Row="2"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="White"
                 ItemsSource="{Binding NavigationItems}"
                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Padding="8" Text="{Binding Title}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="32">
      <TextBlock Text="{Binding CurrentPage.Title}" FontSize="28" FontWeight="SemiBold" />
      <ContentControl Grid.Row="1" Margin="0,24,0,0" Content="{Binding CurrentPage}" />
    </Grid>
  </Grid>
</Window>
