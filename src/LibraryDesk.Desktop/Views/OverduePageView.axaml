<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LibraryDesk.Desktop.Views.OverduePageView">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Overdue loans" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button Content="Refresh" Command="{Binding RefreshCommand}" />
    </StackPanel>
    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#526173" TextWrapping="Wrap" />
    <Border Grid.Row="2" Padding="12" Background="#F4F6F9" CornerRadius="8">
      <ListBox ItemsSource="{Binding OverdueLoans}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="110,*,*,160,110,110" Margin="4">
              <TextBlock Text="{Binding MembershipNumber}" />
              <TextBlock Grid.Column="1" Text="{Binding ReaderName}" />
              <TextBlock Grid.Column="2" Text="{Binding BookTitle}" />
              <TextBlock Grid.Column="3" Text="{Binding Barcode}" />
              <TextBlock Grid.Column="4" Text="{Binding DueOn}" />
              <TextBlock Grid.Column="5" Text="{Binding DaysOverdue, StringFormat={}{0} days late}" FontWeight="SemiBold" Foreground="#A4262C" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
