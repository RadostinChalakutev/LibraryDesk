<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LibraryDesk.Desktop.Views.BookPageView">
  <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,*,Auto" ColumnSpacing="24" RowSpacing="16">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox Width="300" Watermark="Search title, author, or ISBN" Text="{Binding SearchText, Mode=TwoWay}" />
      <Button Content="Search" Command="{Binding RefreshCommand}" />
    </StackPanel>
    <Border Grid.Row="1" Padding="12" Background="#F4F6F9" CornerRadius="8">
      <ListBox ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,180,80,80" Margin="4">
              <TextBlock Text="{Binding Title}" />
              <TextBlock Grid.Column="1" Text="{Binding Author}" />
              <TextBlock Grid.Column="2" Text="{Binding CopyCount}" />
              <TextBlock Grid.Column="3" Text="{Binding AvailableCopyCount}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Border Grid.Row="2" Padding="12" Background="#F4F6F9" CornerRadius="8">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding SelectedBookTitle}" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="240" Watermark="Barcode to scan in Loans" Text="{Binding Barcode, Mode=TwoWay}" />
          <Button Content="Generate barcode" Command="{Binding GenerateBarcodeCommand}" />
          <Button Content="Add copy" Command="{Binding AddCopyCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Copies}" MaxHeight="130">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="4"><TextBlock Text="{Binding Barcode}" /><TextBlock Text="{Binding Status}" /></StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>
    <Border Grid.Column="1" Grid.RowSpan="3" Padding="20" Background="#F4F6F9" CornerRadius="8">
      <StackPanel Spacing="10">
        <TextBlock Text="Add catalogue title" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Title" /><TextBox Text="{Binding Title, Mode=TwoWay}" />
        <TextBlock Text="Author" /><TextBox Text="{Binding Author, Mode=TwoWay}" />
        <TextBlock Text="ISBN" /><TextBox Text="{Binding Isbn, Mode=TwoWay}" />
        <TextBlock Text="Category" /><TextBox Text="{Binding Category, Mode=TwoWay}" />
        <TextBlock Text="Published year" /><TextBox Text="{Binding PublishedYear, Mode=TwoWay}" />
        <TextBlock Text="{Binding StatusMessage}" Foreground="#526173" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Add book" Command="{Binding AddBookCommand}" /><Button Content="Clear" Command="{Binding NewBookCommand}" /></StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
