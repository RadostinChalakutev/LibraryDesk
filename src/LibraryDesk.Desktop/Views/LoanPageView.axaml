<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LibraryDesk.Desktop.Views.LoanPageView">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <Border Padding="20" Background="#F4F6F9" CornerRadius="8">
      <Grid ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
        <TextBlock Text="Reader membership number" />
        <TextBlock Grid.Column="1" Text="Physical-copy barcode" />
        <TextBlock Grid.Column="2" Text="Due date (YYYY-MM-DD)" />
        <TextBox Grid.Row="1" Text="{Binding MembershipNumber, Mode=TwoWay}" />
        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding Barcode, Mode=TwoWay}" />
        <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding DueOn, Mode=TwoWay}" />
        <Button Grid.Column="3" Grid.Row="1" Content="Borrow" Command="{Binding BorrowCommand}" />
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#526173" TextWrapping="Wrap" />
    <Border Grid.Row="2" Padding="12" Background="#F4F6F9" CornerRadius="8">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Active loans" FontSize="18" FontWeight="SemiBold" /><Button Content="Refresh" Command="{Binding RefreshCommand}" /><Button Content="Return selected" Command="{Binding ReturnCommand}" /></StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding ActiveLoans}" SelectedItem="{Binding SelectedLoan, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="110,*,*,160,110" Margin="4">
                <TextBlock Text="{Binding MembershipNumber}" />
                <TextBlock Grid.Column="1" Text="{Binding ReaderName}" />
                <TextBlock Grid.Column="2" Text="{Binding BookTitle}" />
                <TextBlock Grid.Column="3" Text="{Binding Barcode}" />
                <TextBlock Grid.Column="4" Text="{Binding DueOn}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
